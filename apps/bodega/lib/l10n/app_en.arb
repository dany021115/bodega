  "issueNoRosettaTitle": "Rosetta is missing",
  "@issueNoRosettaTitle": {
    "description": "Title of a requirement card on the setup page: the Mac lacks Rosetta 2, which Bodega needs. The command that installs it shows under the card's text, with setupCopyCommand."
  },
  "issueNoRosettaDetail": "Windows games run on Rosetta 2.",
  "@issueNoRosettaDetail": {
    "description": "Under issueNoRosettaTitle, on its requirement card: why Rosetta 2 is needed."
  },
  "issueUnsupportedCpuTitle": "Unsupported processor",
  "@issueUnsupportedCpuTitle": {
    "description": "Title of a requirement card on the setup page (Linux): the computer's processor is not x86_64, so Bodega cannot run there. The card has no command."
  },
  "issueUnsupportedCpuDetail": "Bodega needs an x86_64 processor.",
  "@issueUnsupportedCpuDetail": {
    "description": "Under issueUnsupportedCpuTitle, on its requirement card. x86_64 is the name of a processor architecture."
  },
  "issueNoVulkanTitle": "Vulkan is missing",
  "@issueNoVulkanTitle": {
    "description": "Title of a requirement card on the setup page (Linux): the system lacks Vulkan, a graphics library, or a driver for it. The command that installs them shows under the card's text."
  },
  "issueNoVulkanDetail": "Games draw with Vulkan (DXVK).",
  "@issueNoVulkanDetail": {
    "description": "Under issueNoVulkanTitle, on its requirement card: why Vulkan is needed. DXVK is the backend that draws with it."
  },
  "issueNoAudioTitle": "Audio is missing",
  "@issueNoAudioTitle": {
    "description": "Title of a requirement card on the setup page (Linux): the system lacks the PulseAudio library, so games would have no sound. The command that installs it shows under the card's text."
  },
  "issueNoAudioDetail": "Wine needs PulseAudio, or PipeWire with Pulse support.",
  "@issueNoAudioDetail": {
    "description": "Under issueNoAudioTitle, on its requirement card. PulseAudio and PipeWire are Linux sound systems; Pulse is short for PulseAudio."
  },
  "issuePadNoAccessTitle": "No access to the controller {pad}",
  "@issuePadNoAccessTitle": {
    "description": "Title of a requirement card in the controllers section of a bottle's page (Linux): Bodega cannot open that game controller, so games will not see it. The command that installs the rules that allow it shows under the card's text.",
    "placeholders": {
      "pad": {
        "type": "String",
        "example": "Microsoft X-Box 360 pad",
        "description": "The controller's name, as the system gives it."
      }
    }
  },
  "issuePadNoAccessDetail": "Bodega can't open the controller, so Wine won't see it. Install the controller udev rules (on Arch, the package is in multilib), then unplug the controller and plug it in again.",
  "@issuePadNoAccessDetail": {
    "description": "Under issuePadNoAccessTitle, on its requirement card: what the command under it installs, and what to do after. udev is the Linux device manager; multilib is a repository of Arch Linux."
  },
  "issueNoSdlTitle": "SDL2 is missing",
  "@issueNoSdlTitle": {
    "description": "Title of a requirement card in the controllers section of a bottle's page (Linux): the system lacks SDL2, a library Wine reads game controllers through. The command that installs it shows under the card's text."
  },
  "issueNoSdlDetail": "Wine uses SDL2 to understand controllers. Without it, Wine uses udev, which knows fewer controllers.",
  "@issueNoSdlDetail": {
    "description": "Under issueNoSdlTitle, on its requirement card. SDL2 is a library (feminine in Spanish, la biblioteca); udev is the Linux device manager."
  },
