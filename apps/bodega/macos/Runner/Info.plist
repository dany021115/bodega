<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>es</string>
	</array>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Bodega looks in Downloads for the Game Porting Toolkit you downloaded from Apple, to install D3DMetal.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Games use the local network for LAN matches with other computers in your home.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Windows games use the microphone for voice chat.</string>
	<key>NSCameraUsageDescription</key>
	<string>A Windows program wants to use the camera.</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Skia instead of Impeller. On Apple Silicon, Flutter 3.47's Impeller
	     switches the window between wide gamut and sRGB when its screen
	     changes, as when a game goes fullscreen. A frame drawn during that
	     switch gets no texture, and Bodega quit in
	     impeller::Canvas::SetupRenderPass (canvas.cc:1615), three times in
	     one MW3 session. With Skia, Bodega lasted a whole session. Remove
	     this key once Flutter fixes it. -->
	<key>FLTEnableImpeller</key>
	<false/>
</dict>
</plist>
